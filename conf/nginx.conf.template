# Lua router (OpenResty) 配置模板
# 由 docker-entrypoint.sh 用 envsubst 渲染成 nginx.conf
# 变量: WORKER_PROCESSES WORKER_CONNECTIONS NOFILE_LIMIT ERROR_LOG_PATH LOG_LEVEL
#       LISTEN_ADDR LUA_PACKAGE_PATH DNS_RESOLVER MAX_PAYLOAD_SIZE
#       SERVER_EXTRA HTTP_EXTRA METRICS_EXTRA
#       TLS_LISTEN_FLAGS TLS_SERVER_EXTRA (SMG_TLS_* 配置时由入口脚本渲染)
# 其余运行参数（策略、熔断、健康检查、重试等）全部由
# resty.luarouter.config 在 init 阶段直接读环境变量，不经过这里。

# WORKER_PROCESSES comes from NGINX_WORKER_PROCESSES and defaults to auto, i.e.
# one nginx process per core. cache_aware is the exception and the entrypoint
# forces it to 1 unless the operator set the number explicitly: the radix tree is
# per-process state (the affinity tree is per-process), so N processes keep N
# approximate trees and prefix affinity degrades to 1/N of what Rust achieves.
# The shared-dict snapshot carries each tree across a reload but not across
# processes, so widening the worker count costs stickiness, not correctness.
# The other stateful policies (bucket, manual, the hash rings) are unaffected.
# 在途请求年龄采样器（doc/gap-inflight-age.md）：LR_INFLIGHT_SAMPLE_SECS /
# LR_INFLIGHT_TTL_SECS 在 init_by_lua 里 fork 之前抓取（init.lua wire_inflight_tracker），
# worker 环境随后被 nginx 重建，所以这两个名字也要在 env 白名单里声明一遍。
# 两个都可省略：默认按 Rust 的 20 s 采样、槽位 TTL 3600 s。
env LR_INFLIGHT_SAMPLE_SECS;
env LR_INFLIGHT_TTL_SECS;
# 按虚拟入口/实际模型/服务聚合的指标族（smg_entry_* / smg_worker_requests_total）。
# 缺省开启；LR_MODEL_METRICS=off 是高基数逃生阀：写侧停写、抓取侧按族名前缀过滤。
# 漏声明会被 nginx 的 env 白名单静默忽略（读不到值也不报错），所以三份 conf 必须同步。env LR_MODEL_METRICS;

# 进程内 watcher（doc/gap-watcher-merge.md，独立 llm-watcher 守护进程的合并形态）：
# SMG_WATCHER_* 由 resty.luarouter.config 在 init_by_lua 里解析（与其余 SMG_* 同一
# 读法，fork 之前完成）；这里的 env 声明把它们再放行到 worker 进程，请求期
# （GET/POST /model-map、/_ui/config）才读得到。全部可省略：SMG_WATCHER_ENABLED
# 默认 off，不开就没有定时器、没有 discovery、也没有 lr_watch 的写入。
env SMG_WATCHER_ENABLED;
env SMG_WATCHER_TARGETS;
env SMG_WATCHER_DOCKER;
env SMG_WATCHER_PROC_SCAN;
env SMG_WATCHER_CONTAINER_IPS;
env SMG_WATCHER_DOCKER_SOCKET;
env SMG_WATCHER_INTERVAL_SECS;
env SMG_WATCHER_PROBE_TIMEOUT_SECS;
env SMG_WATCHER_REMOVE_GRACE_SECS;
env SMG_WATCHER_KEEP_LAST_GRACE_SECS;
env SMG_WATCHER_ALLOW_REMOVE;
env SMG_WATCHER_PROBE_FAILURES;
env SMG_WATCHER_PROBE_FUSE;
env SMG_WATCHER_MAX_MODELS;
env SMG_WATCHER_REQUIRE_HEALTH;
env SMG_WATCHER_ALLOW_MODELS_ONLY;
env SMG_WATCHER_SHORT_MODEL_NAMES;
env SMG_WATCHER_ADD_CONFIRM_TIMEOUT_SECS;
env SMG_WATCHER_EXCLUDE;
env SMG_WATCHER_ALLOW_PORT;
env SMG_WATCHER_DENY_PORT;
env SMG_WATCHER_MODEL_MAP;

# GPU 功率通道（每 worker 的功率上限，registry.capacity_exclusion）：其余 SMG_LOAD_* 由
# resty.luarouter.config 在 init_by_lua 里解析（fork 之前，不受白名单影响），而这三个由
# gpu_load.lua 在 worker 定时器里用 os.getenv 现读，所以必须在这里声明——nginx 按 env
# 白名单重建 worker 环境，漏声明的名字读回来是 nil，功能是静默失效的。生效方式是重启
# 容器（worker 环境 fork 后不再变化），改 compose 里的值即可。
#   SMG_LOAD_POWER       =1 时 metrics 路顺带扫功率 gauge（缺省 off）
#   SMG_LOAD_POWER_KEYS  覆盖功率 gauge 名单，逗号/空格分隔
#   SMG_LOAD_POWER_QUERY prom 路的第二条 PromQL，留空 = 不采功率
# 注意：功率是**搭载**在负载源上的，SMG_LOAD_SOURCE 仍是总开关——它是 none 时定时器
# 根本不启动，这里设了 SMG_LOAD_POWER 也不会有任何读数（不是 bug，是为了不给一个
# 关掉的子系统留第二条独立抓取路径）。prom 路的合法组合是「SMG_LOAD_PROM_URL +
# SMG_LOAD_PROM_QUERY（负载）+ 可选 SMG_LOAD_POWER_QUERY（功率）」，两条查询各自独立。
env SMG_LOAD_POWER;
env SMG_LOAD_POWER_KEYS;
env SMG_LOAD_POWER_QUERY;


worker_processes ${WORKER_PROCESSES};
worker_rlimit_nofile ${NOFILE_LIMIT};
# 容器内以 root 运行，共享字典与日志目录都在镜像内，无需降权
user root;
error_log ${ERROR_LOG_PATH} ${LOG_LEVEL};
pid       logs/nginx.pid;

events {
    worker_connections ${WORKER_CONNECTIONS};
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    # stock mime.types (OpenResty 1.31) lacks these; the SvelteKit UI needs both
    types {
        application/manifest+json webmanifest;
        text/javascript mjs;
    }
    sendfile      on;
    tcp_nopush    on;
    keepalive_timeout 65;
    server_tokens off;

    # luarouter 模块（?/init.lua 命中 resty/luarouter/init.lua）
    lua_package_path "${LUA_PACKAGE_PATH}";

    # 上游探测与转发的 socket 错误由路由自己记录，不需要 nginx 再抄一份
    lua_socket_log_errors off;
    lua_socket_connect_timeout 10s;
    lua_socket_read_timeout 60s;
    lua_socket_send_timeout 60s;

    # 推理请求正文要整体读入：抽 model + 路由文本，改写 model 后再转发
    client_max_body_size ${MAX_PAYLOAD_SIZE};
    client_body_buffer_size 4m;
    client_body_timeout 600s;
    client_header_timeout 60s;
    # 超时由转发协程自己的 cosocket 超时控制，这里放宽避免提前断开长流
    send_timeout 600s;
    request_pool_size 4k;
    lua_use_default_type off;

    # 与 ARCHITECTURE.md 对齐的五个共享字典：
    #   lr_workers      worker 记录 + 健康/熔断/负载计数 + url->id + job 状态
    #   lr_policy       策略状态（round_robin 游标、manual 粘性映射）
    #   lr_stats        计数器/直方图/滑窗样本
    #   lr_request_log  /_ui/logs 环形缓冲
    #   lr_locks        registry 写入互斥锁
    lua_shared_dict lr_workers     2m;
    lua_shared_dict lr_policy     20m;
    lua_shared_dict lr_stats       5m;
    lua_shared_dict lr_request_log 20m;
    lua_shared_dict lr_locks       1m;
    # 进程内 watcher 的 ledger：protected / owned / pending / back-off / model-map
    # （resty.luarouter.watcher）。缺失时 watcher 拒绝启动并留一条 WARN，其余功能不受影响。
    lua_shared_dict lr_watch        64k;
    # 并发限流的 token / 活跃 / 排队计数（SMG_MAX_CONCURRENT_REQUESTS），
    # 跨 nginx 进程共享同一份预算
    lua_shared_dict lr_limit      64k;

    # 跨 worker 广播 RuntimeConfig 快照（config_store.lua 用）。缺失时该模块
    # 退化为「每次现读 LMR_CONFIG_FILE（0.5s TTL）」，功能不挂但一致性变差。
    lua_shared_dict luarouter_config 1m;

    resolver ${DNS_RESOLVER} ipv6=off valid=30s;
    resolver_timeout 5s;

    init_by_lua_block {
        require("resty.luarouter").init()
    }

    init_worker_by_lua_block {
        require("resty.luarouter").worker_init()
    }

    # 客户端中途断开时也要走到这里：归还未释放的 load 计数
    log_by_lua_block {
        require("resty.luarouter").on_log()
    }

    server {
        # TLS_LISTEN_FLAGS 为 " ssl" 时主监听直接变成 TLS 监听（与 Rust 的
        # rustls 一样是替换明文监听，而不是另开端口）。
        listen ${LISTEN_ADDR}${TLS_LISTEN_FLAGS};
        server_name _;
${TLS_SERVER_EXTRA}

        # 预检在 rewrite 阶段应答：nginx 还没选 location 就先跑 server 级 rewrite，
        # 于是 ui.conf 那些自带方法门的 /_ui/* 也能吃到统一的 CORS 预检（与 Rust
        # 的 CorsLayer 最外层等价）。
        rewrite_by_lua_block {
            if require("resty.luarouter.router").preflight_guard() then
                return ngx.exit(200)
            end
        }

        # 全部端点（推理面 / 控制面 / 公开面 / _ui）由 klib.router 分发
        location / {
            content_by_lua_block {
                require("resty.luarouter.router").handle()
            }
        }


        # 追加 location（静态 UI、健康探测别名等）由入口脚本注入
        ${SERVER_EXTRA}
    }

    # 独立的 Prometheus 端口（可选，SMG_METRICS_PORT 设置后启用）
    ${METRICS_EXTRA}


    # http{} 层追加配置
    ${HTTP_EXTRA}
}
