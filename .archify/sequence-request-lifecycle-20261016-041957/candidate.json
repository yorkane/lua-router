  "cards": [
    {
      "dot": "emerald",
      "title": "四个阶段",
      "items": [
        "准入：本机并发闸（满即 429）→ model 字段校验 → 入口 api-key 门 → 别名与 profile 解析",
        "api-key 门 fail-closed：读点在场且条目配了密钥时，比对函数缺失或出错一律拒绝",
        "选路：候选四道门装配出候选集，策略在候选集里选一台",
        "四道门依次是健康 → 白名单/绑定 → 模型许可 → 容量（并发上限、GPU 利用率上限）",
        "x-smg-target-worker 头优先于策略，但不能复活已被容量闸排除的 worker",
        "转发：effort 卡片按选中实例的绑定名逐次改写，失败退避换候选重试，次数耗尽答 502",
        "响应：流式不缓冲边收边拷；非流式读完把 socket 还回共享连接池"
      ]
    },
    {
      "dot": "rose",
      "title": "拒绝与重试在哪发生",
      "items": [
        "闸满 429 与 api-key 401 都发生在选路之前，请求不进候选装配",
        "429 与 503 的分叉点在转发循环：前者是全池容量到顶，后者是熔断或不健康",
        "重试只在拿到响应之后判定，不消耗额定的尝试次数以外的状态"
      ]
    },
    {
      "dot": "slate",
      "title": "网关刻意不碰的东西",
      "items": [
        "输出预算原样透传：给多少转发多少，没给也不代填",
        "推理体只做顶层精确改写，不整表重编码",
        "跨请求状态只走 ngx.shared，请求之间不共享 Lua 对象"
      ]
    }
  ]
