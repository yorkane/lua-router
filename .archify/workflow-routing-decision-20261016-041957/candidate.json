  "cards": [
    {
      "dot": "cyan",
      "title": "候选四道门",
      "items": [
        "依次是健康 → 白名单/绑定 → 模型许可 → 容量，顺序即短路顺序",
        "容量是硬排除而不是排序项：被排除的 worker 策略根本看不见",
        "并发上限与 GPU 利用率上限都在这里判；读数未知时不排除"
      ]
    },
    {
      "dot": "rose",
      "title": "两个 429 与一个 503",
      "items": [
        "本机并发闸满：请求还没进选路就 429",
        "池内所有实例都被容量闸排除：429（不是 503），含义是暂时接不了单",
        "熔断打开、不健康、或组内没有引擎服务这个模型：503"
      ]
    },
    {
      "dot": "emerald",
      "title": "网关不替调用方决定的事",
      "items": [
        "输出预算原样透传：给多少转发多少，没给也不代填",
        "虚拟入口的 effort 映射只改写档位，不碰输出预算",
        "被藏（hidden）的实际模型照常作为入口落点被服务，只是不在 /v1/models 里广告"
      ]
    }
  ]
