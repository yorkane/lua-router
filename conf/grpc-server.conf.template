# ============================================================================
# lua-router gRPC 推理面（可选监听，SMG_GRPC_PORT > 0 时由 docker-entrypoint.sh
# envsubst 渲染并 include 进 http{}）
# ============================================================================
# 变量: GRPC_LISTEN_ADDR GRPC_READ_TIMEOUT GRPC_MAX_BODY_SIZE GRPC_POLICY
#       GRPC_LUALIB_SUFFIX（保留给未来）
#
# 为什么必须是独立 server：
#   * grpc_pass 只能出现在 location{}（写在 server{} 里 nginx 报
#     '"grpc_pass" directive is not allowed here'）；
#   * gRPC 的 :path 就是 /<package>.<service>/<method>（sglang 是
#     /sglang.grpc.model_service.ModelService/Generate），和主 server 的
#     klib.router 路由表不是一个形状；
#   * 这个端口只讲 HTTP/2：`listen` + `http2 on` 之后 HTTP/1.1 请求会被 nginx
#     以 502 拒掉（实测），所以就绪/控制面永远留在主端口。
#
# 上游形态选「变量式 grpc_pass」而不是 upstream + balancer_by_lua：
#   balancer.set_current_peer() 只吃 IP 字面量，域名报 "no host allowed"；变量式
#   走 http{} 的 resolver，域名 worker 天然可用（实测 p50 0.9ms vs 0.8ms）。
#
# 失败不做 nginx 层重试：error_page 502 = @retry 的实测结果是第二次请求丢了 body
# （后端回 UNIMPLEMENTED "requires exactly one request message"），而 grpc_pass 的
# 变量式上游本来也不参与 grpc_next_upstream。换 worker 由下一请求的 Lua 决定，
# 与 HTTP 面「重试在 Lua 层」的既有分工一致。
#
# 语法 gate：
#   docker run --rm -v "$PWD:/repo:ro" --entrypoint openresty authz:latest \
#     -t -p /usr/local/openresty/nginx/ -c /repo/conf/grpc-prototype.conf

server {
    listen ${GRPC_LISTEN_ADDR};
    http2 on;
    server_name _;

    # grpc_proxy.setup() 写、下面各指令读的运行期变量。未声明的变量 setup() 会跳过
    # 并在 error_log 点名，所以精简部署可以只保留 lr_grpc_peer。
    set $lr_grpc_worker "";
    set $lr_grpc_pool   "";
    set $lr_grpc_scheme "grpc";
    set $lr_grpc_peer   "";
    set $lr_grpc_host   "";
    set $lr_grpc_port   "";
    set $lr_grpc_timeout "";

    # The lr_grpc format itself is declared in http{} by the entrypoint (log_format
    # is an http-only directive and this fragment is included into a server{}).
    access_log /dev/stderr lr_grpc;

    # 正文按 gRPC 帧流转发：一次调用一个完整消息，上行大小仍受 client_max_body_size
    # 约束（与 Rust 的 DefaultBodyLimit/MAX_PAYLOAD_SIZE 同值）。
    client_max_body_size ${GRPC_MAX_BODY_SIZE};
    # 长生成不掐断；真正的上限是 grpc-timeout（由 Lua 按 request_timeout_secs 算）。
    grpc_read_timeout ${GRPC_READ_TIMEOUT};

    location / {
        access_by_lua_block {
            local grpc_proxy = require("resty.luarouter.grpc_proxy")
            grpc_proxy.route({ policy = "${GRPC_POLICY}" })
        }

        # nginx 不会自己给上游加 te: trailers，而后端只有见到它才发 trailer；
        # 少了这一行 grpc 客户端拿到 502。
        grpc_set_header TE "trailers";
        # 路由重算的 deadline 覆盖客户端的（实测三档：客户端 1H + cap=3 -> 3.013s，
        # 客户端 1S + cap=3 -> 1.010s，客户端不发 + cap=2 -> 2.012s）。
        grpc_set_header grpc-timeout $lr_grpc_timeout;
        grpc_set_header x-lr-worker $lr_grpc_worker;

        # grpcs workers are internal and ship self-signed certificates, so the
        # certificate is not verified -- the same stance the HTTP plane takes for
        # https workers (registry.tls_handshake does sslhandshake(…, false)).
        grpc_ssl_verify off;
        grpc_pass $lr_grpc_scheme://$lr_grpc_peer;

        # 这个 location 的 log 阶段覆盖 http{} 层那一份，所以两边的账都要还：
        # luarouter.on_log() 归还并发令牌与泄漏的 load 守卫，grpc_proxy.on_log()
        # 归还 gRPC 侧 load 并按 grpc-status / upstream_status 给熔断器记账。
        log_by_lua_block {
            require("resty.luarouter").on_log()
            require("resty.luarouter.grpc_proxy").on_log()
        }
    }
}
